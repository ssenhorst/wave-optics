  "task": {
    "title": "Print at half the pitch with a phase-shift mask",
    "description": "The lens images the mask onto the plane at the right. The mask bars are opaque chrome to begin with. Make them clear instead, and give them a phase shift, until the printed lines come out twice as close together as the bars on the mask.",
    "hint": "Opaque bars leave a strong zero order, which sets the printed period equal to the mask pitch. Bars that pass the light but turn it upside down in phase cancel the zero order, leaving only the two first orders, which beat together at half the period. The phase shift wanted is pi, about 3.14.",
    "successMessage": "An alternating phase-shift mask: the same mask pitch prints twice as fine, which is why they are used for the tightest layers.",
    "goals": [
      {
        "id": "halfpitch",
        "type": "waveFringeSpacing",
        "title": "Print lines 40 units apart",
        "line": {
          "p1": {
            "x": 600,
            "y": -110
          },
          "p2": {
            "x": 600,
            "y": 110
          }
        },
        "spacing": 40,
        "tolerance": 7,
        "samples": 561
      }
    ]
  }
